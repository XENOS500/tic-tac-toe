{
  "name": "@anti-gravity/server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace=@anti-gravity/shared",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anti-gravity/shared": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nanoid": "^3.3.8",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
